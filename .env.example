# ---- Hermes -----------------------------------------------------------------
# host.docker.internal works when Hermes runs on the Docker host itself.
HERMES_URL=http://host.docker.internal:7237/v1
HERMES_KEY=dein-api-server-key
HERMES_MODEL=hermes
HERMES_STREAM=1

# ---- speech -----------------------------------------------------------------
LANGUAGE=de

# Variante A (Default): CTranslate2 auf der CPU.
# Das Modell ist deutsch-getunt, turbo und bereits int8 -- deshalb
# WHISPER_COMPUTE=default (der im Modell gespeicherte Typ wird genommen).
# Bei LANGUAGE!=de stattdessen ein generisches Modell setzen, z.B. large-v3-turbo.
#
# Zielhardware ist ein Pentium Gold 8505 (1 P-Core + 4 E-Cores). Der
# Whisper-Encoder ist dort der Flaschenhals. Wenn es zu langsam ist, in dieser
# Reihenfolge: Variante B (iGPU) -> WHISPER_MODEL=medium -> small.
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# 0 = alle Kerne
WHISPER_CPU_THREADS=0
WHISPER_BEAM=1

# Variante B: Intel-iGPU via OpenVINO. Braucht ein exportiertes Modell und den
# Compose-Override docker-compose.intel-gpu.yml.
#   optimum-cli export openvino --model openai/whisper-large-v3-turbo \
#       --weight-format int8 ./models/whisper-turbo-int8
# WHISPER_BACKEND=openvino
# WHISPER_MODEL=/models/whisper-turbo-int8
# WHISPER_DEVICE=GPU

PIPER_VOICE=de_DE-thorsten-medium
PIPER_MODEL=/voices/de_DE-thorsten-medium.onnx
PIPER_LENGTH_SCALE=1.0

# ---- endpointing ------------------------------------------------------------
VAD_AGGRESSIVENESS=2
VAD_THRESHOLD=0.6
VAD_MIN_SILENCE_MS=700
VAD_SPEECH_PAD_MS=300
NO_SPEECH_TIMEOUT_S=8

# ---- timings pushed to the device ------------------------------------------
FOLLOW_UP_MS=6000
PLAYBACK_PREBUFFER_MS=400

LOG_LEVEL=INFO
